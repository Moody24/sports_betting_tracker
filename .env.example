# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# ── Database ──────────────────────────────────────────────────────────
# Local development (SQLite — no setup required):
DATABASE_URL=sqlite:///app.db

# PostgreSQL (when connecting to a hosted DB like Neon):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Note: "postgres://" URLs are automatically rewritten to "postgresql://"
# for SQLAlchemy compatibility.

# ── The Odds API ─────────────────────────────────────────────────────
# https://the-odds-api.com (free tier available)
# Required for live over/under lines and player props on the NBA Today page.
# Without it, the app still runs — live odds pages degrade gracefully.
ODDS_API_KEY=your-odds-api-key-here
ODDS_API_BUDGET_FLOOR=25
# Override only for a compatible provider/proxy.
ODDS_API_HISTORICAL_URL=https://api.the-odds-api.com/v4/historical/sports/basketball_nba/odds
ODDS_API_HISTORICAL_SNAPSHOT_HOUR_UTC=18

# ── Flask ─────────────────────────────────────────────────────────────
# Set to "true" for local development
FLASK_DEBUG=true
FLASK_ENV=development
# Absolute origin used for canonical and sitemap URLs. Production requires HTTPS.
PUBLIC_BASE_URL=http://localhost:5000
# Railway injects these. Do not set them for normal local development.
# RAILWAY_ENVIRONMENT=
# PORT=8000
# Flask/internal process markers; not operator settings.
# FLASK_RUN_FROM_CLI=
# RUNNING_CLI=

# Cookie/session security. Secure cookies default on in production.
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
# Sliding idle timeout and hard absolute lifetime for authenticated sessions.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
REMEMBER_COOKIE_DAYS=14

# ── Scheduler ────────────────────────────────────────────────────────
# Keep "false" locally — trigger jobs manually via Flask CLI commands.
# Set to "true" only on a dedicated scheduler process (e.g. Railway service).
SCHEDULER_ENABLED=false
# Optional login-time background generation; keep disabled in production web workers.
AUTO_PICKS_ON_LOGIN=false
# The stats.nba.com refresh path is dormant unless explicitly enabled.
ENABLE_NBA_API_PLAYER_REFRESH=false

# ── Database connection pool (PostgreSQL only) ───────────────────────
# These are ignored for SQLite. Tune when connecting to PostgreSQL if you
# see "QueuePool limit of size N overflow N reached".
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# Local-only escape hatch. Hosted deployment uses Railway's pre-deploy command;
# keep this false there so web/scheduler processes never race migrations.
AUTO_DB_UPGRADE=false

# ── Auto-pick thresholds ─────────────────────────────────────────────
# Maximum auto-generated bets per daily run
AUTO_PICK_MAX_TOTAL=50
# Minimum edge required for a straight (1-leg) auto pick
AUTO_PICK_MIN_EDGE_STRAIGHT=0.15
# Minimum edge per leg for a 2-leg parlay auto pick
AUTO_PICK_MIN_EDGE_2LEG=0.15
# Minimum edge per leg for a 3-leg parlay auto pick
AUTO_PICK_MIN_EDGE_3LEG=0.15
# Minimum career games before a player is eligible for auto picks
AUTO_PICK_MIN_GAMES=15
# Minimum Model 2 confidence tier: "strong" | "medium" | "any"
AUTO_PICK_CONFIDENCE_TIER=strong

# Paper cohorts are disabled explicitly for a conservative deployment.
AUTO_PAPER_ENABLED=false
AUTO_PAPER_MAX_PER_COHORT=24
AUTO_PAPER_MIN_GAMES=10

# ── Projection and pick-quality models ───────────────────────────────
USE_ML_PROJECTIONS=false
USE_DISTRIBUTIONAL_MODEL=false
USE_SCENARIO_SIGNAL=false
MODEL2_INCLUDE_PAPER_COHORTS=false
MODEL2_PROBABILITY_SHRINK=0.88
MODEL2_CALIBRATION_BIAS=0.0
MODEL2_TAKE_IT_THRESHOLD=0.60
MODEL2_CAUTION_THRESHOLD=0.56

# ── Market recommender thresholds (moneyline / totals) ───────────────
# Leave blank to use the values stored in ModelMetadata (or fallback defaults).
MARKET_REC_MIN_EDGE_ML=
MARKET_REC_MIN_CONF_ML=
MARKET_REC_MIN_EDGE_TOTAL=
MARKET_REC_MIN_CONF_TOTAL=

# Kill-switches — set to "false" to disable a market type entirely
MONEYLINE_RECS_ENABLED=true
TOTAL_RECS_ENABLED=true

# Scheduled market-governance defaults. Applying governance changes is opt-in.
MARKET_GOV_APPLY=false
MARKET_GOV_DAYS=180
MARKET_GOV_BINS=5
MARKET_GOV_MIN_BETS=20
MARKET_GOV_DRIFT_THRESHOLD=0.05
MARKET_GOV_TRAIN_DAYS=60
MARKET_GOV_TEST_DAYS=14
MARKET_GOV_STEP_DAYS=14

# Historical snapshot ingestion and coverage reporting.
GAME_SNAPSHOT_BACKFILL_DAYS=45
GAME_SNAPSHOT_BACKFILL_SLEEP=0.05
HISTORICAL_ODDS_INGEST_DAYS=120
HISTORICAL_ODDS_INGEST_SLEEP=0.05
HISTORICAL_ODDS_INGEST_FORCE=false
MARKET_COVERAGE_DAYS=180
MARKET_COVERAGE_TRAIN_DAYS=60
MARKET_COVERAGE_TEST_DAYS=14
MARKET_COVERAGE_STEP_DAYS=14

# ── Model Storage ────────────────────────────────────────────────────
# "local" stores model artifacts in app/ml_models/ (gitignored).
# "s3" stores them in AWS S3 (requires S3 vars below).
MODEL_STORAGE=local

# Enable XGBoost ML projections (set to false to use heuristic fallback only)
# USE_ML_PROJECTIONS=true

# S3 vars (only needed if MODEL_STORAGE=s3):
S3_MODEL_BUCKET=
S3_MODEL_PREFIX=models/
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Rate limiting ────────────────────────────────────────────────────
# memory:// is safe only with the one-worker baseline below. A production
# process with multiple workers fails startup unless this is a shared store.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true

# ── Gunicorn (production only) ────────────────────────────────────────
# Deliberate safe baseline. Raise only after configuring a shared limiter store.
WEB_CONCURRENCY=1

# ── Reserved integrations (not active in the local-only baseline) ───
# REDIS_URL=redis://localhost:6379/0
# WEBHOOK_SIGNING_SECRET_PRIMARY=
# WEBHOOK_SIGNING_SECRET_SECONDARY=
# SENTRY_DSN=
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=
